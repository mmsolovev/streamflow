# Базовый URL API.
# По умолчанию — относительный путь: запросы идут через прокси Vite
# (/api -> http://127.0.0.1:8001), поэтому браузер видит всё как same-origin.
VITE_API_BASE_URL=/api/v1

# Прямое обращение к бэкенду без прокси (нужен настроенный CORS):
# VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
