TWITCH_TOKEN=oauth:your_twitch_oauth_token
TWITCH_NICK=your_bot_nick
TWITCH_CHANNEL=your_channel_name
TWITCH_CHANNELS=your_primary_channel,your_second_channel
TWITCH_BOT_BADGE_CHANNELS=your_channel_where_bot_has_moderator_status
CLIENT_ID=your_twitch_client_id
CLIENT_SECRET=your_twitch_client_secret
IGDB_CLIENT_ID=your_igdb_client_id_or_leave_empty_to_reuse_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret_or_leave_empty_to_reuse_client_secret
BOT_ID=your_twitch_bot_id
CALENDARIFIC_KEY=your_calendarific_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
RAWG_API_KEY=your_rawg_api_key
GAMES_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id
RECOMMENDATIONS_LIMIT=5
RECOMMENDATION_SHEETS_SYNC_DEBOUNCE_SECONDS=15
RECOMMENDATIONS_BANNED_USERS=user1,user2
RECOMMENDATIONS_STREAMER_LOGIN=tabula
RECOMMENDATIONS_STREAMER_DISPLAY_NAME=Tabula
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mishgan_bot

# Telegram: правка анонсов стримов при появлении записи.
# Пока TELEGRAM_ENABLED=false — код есть, но ничего не опрашивает и не правит.
# Ссылка на канал выводится из TWITCH_PRIMARY_CHANNEL, отдельно задавать не нужно.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Числовой id канала вида -100xxxxxxxxxx. @username Bot API примет, но
# telegram/service.py его отклоняет: с @username SQL-фильтр по chat_id
# вернёт пусто и кандидат не найдётся.
# Узнать: python utils/telegram_channel_info.py --channel @имя_канала
TELEGRAM_CHANNEL_ID=
TELEGRAM_VOD_CHECK_DELAY_SECONDS=660
TELEGRAM_VOD_POLL_INTERVAL_SECONDS=60
TELEGRAM_VOD_MAX_ATTEMPTS=5
TELEGRAM_MATCH_WINDOW_BEFORE_HOURS=12
TELEGRAM_MATCH_WINDOW_AFTER_MINUTES=60
TELEGRAM_REBIND_WINDOW_MINUTES=180
TELEGRAM_LINK_DOMAINS=twitch.tv

# Web backend (FastAPI, package backend/). Google Sheets остаётся рабочим UI.
# CORS: origin фронтенда через запятую; пусто = без CORS-заголовков.
BACKEND_CORS_ORIGINS=
BACKEND_COOKIE_NAME=backend_session_id
BACKEND_COOKIE_SECURE=false
BACKEND_SESSION_TTL_DAYS=30
BACKEND_SESSION_CLEANUP_INTERVAL_SECONDS=3600
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# URL фронтенда: при заданном значении /auth/callback редиректит сюда после входа.
BACKEND_FRONTEND_URL=
# Twitch OAuth для веб-входа (Authorization Code flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://127.0.0.1:8001/api/v1/auth/callback
TWITCH_SCOPE=user:read:email
TWITCH_OAUTH_STATE_TTL_SECONDS=600
TWITCH_TOKEN_REFRESH_SKEW_SECONDS=300
BACKEND_OAUTH_STATE_COOKIE_NAME=backend_oauth_state
BACKEND_CSRF_COOKIE_NAME=backend_csrf_token
# ID стримера для ручных пометок; пусто = берётся SHEETS_STREAMER_ID.
BACKEND_STREAMER_ID=
